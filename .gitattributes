# Forzar a GitHub a detectar TypeScript en el frontend
frontend/**/*.tsx linguist-language=TypeScript
frontend/**/*.ts linguist-language=TypeScript

# SQL es de tipo "data" para Linguist y no sale en la barra de lenguajes por defecto;
# el esquema y los datos iniciales son parte real del proyecto, así que lo contamos
database/*.sql linguist-detectable=true
